    {
      "name": "02 - Booking Lifecycle",
      "item": [
        {
          "name": "Create Booking & Save ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst createData = pm.response.json();\r\npm.environment.set(\"bookingId\", createData.bookingid);\r\n\r\npm.test(\"Booking ID exists\", function () {\r\n    pm.expect(createData).to.have.property(\"bookingid\");    \r\n});\r\n\r\npm.test(\"Firstname matches what was sent\", function () {\r\n    pm.expect(createData.booking.firstname).to.equal(pm.variables.get(\"firstName\"));\r\n    pm.expect(createData.booking.lastname).to.equal(pm.variables.get(\"lastName\"));\r\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre-request script\r\nconst firstName = pm.variables.replaceIn('{{$randomFirstName}}');\r\nconst lastName  = pm.variables.replaceIn('{{$randomLastName}}');\r\n\r\npm.collectionVariables.set('firstName', firstName);\r\npm.collectionVariables.set('lastName', lastName);\r\n\r\nconst today = new Date();\r\nconst checkin = new Date(today);\r\ncheckin.setDate(today.getDate() + 7);   // one week from now\r\nconst checkout = new Date(today);\r\ncheckout.setDate(today.getDate() + 10); // three-night stay\r\n\r\nconst fmt = d => d.toISOString().split('T')[0]; // YYYY-MM-DD\r\n\r\npm.collectionVariables.set('checkin', fmt(checkin));\r\npm.collectionVariables.set('checkout', fmt(checkout));\r\n\r\nconst price = Math.floor(Math.random() * (500 - 50 + 1)) + 50; // 50 to 500\r\npm.collectionVariables.set('totalPrice', price);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstName}}\",\r\n  \"lastname\": \"{{lastName}}\",\r\n  \"totalprice\": {{totalPrice}},\r\n  \"depositpaid\": true,\r\n  \"bookingdates\": { \"checkin\": \"{{checkin}}\", \"checkout\": \"{{checkout}}\" },\r\n  \"additionalneeds\": \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bookerUrl}}/booking",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get All Booking IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response is an array of booking objects containing bookingid\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.be.an(\"array\").that.is.not.empty;\r\n    pm.expect(data[0]).to.have.property(\"bookingid\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bookerUrl}}/booking",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Booking by Dynamic ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking details match created payload schema\", function () {\r\n    const getData = pm.response.json();\r\n    pm.expect(getData.firstname).to.equal(pm.variables.get(\"firstName\"));\r\n    pm.expect(getData.totalprice).to.equal(pm.variables.get(\"totalPrice\"));\r\n    pm.expect(getData.bookingdates).to.have.all.keys(\"checkin\", \"checkout\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bookerUrl}}/booking/{{bookingId}}",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Booking Fully",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Booking is updated completely\", function () {\r\n    const putData = pm.response.json();\r\n    pm.expect(putData.lastname).to.equal(pm.variables.get(\"lastName\"));\r\n    pm.expect(putData.totalprice).to.equal(pm.variables.get(\"totalPrice\"));\r\n    pm.expect(putData.depositpaid).to.be.false;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstName}}\",\r\n  \"lastname\": \"{{lastName}}\",\r\n  \"totalprice\": {{totalPrice}},\r\n  \"depositpaid\": false,\r\n  \"bookingdates\": { \"checkin\": \"2026-11-01\", \"checkout\": \"2026-11-12\" },\r\n  \"additionalneeds\": \"Late Checkout\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bookerUrl}}/booking/{{bookingId}}",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "booking",
