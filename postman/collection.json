        {
          "name": "Update Booking Partially",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n    const patchData = pm.response.json();\r\n\r\n    pm.test(\"Firstname and totalprice updated, other fields persist\", function () {\r\n        pm.expect(patchData.firstname).to.equal(pm.variables.get(\"firstName\"));\r\n        pm.expect(patchData.lastname).to.equal(pm.variables.get(\"lastName\"));\r\n        pm.expect(patchData.totalprice).to.equal(Number(pm.variables.get(\"totalPrice\")));\r\n    });\r\n}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const price = Math.floor(Math.random() * (500 - 50 + 1)) + 50; // 50 to 500\r\npm.collectionVariables.set('totalPrice', price);"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{basic_auth_083a}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"{{firstName}}\",\r\n    \"lastname\": \"{{lastName}}\",\r\n    \"totalprice\": {{totalPrice}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bookerUrl}}/booking/{{bookingId}}",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
