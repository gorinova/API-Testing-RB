    {
      "name": "03 - Filtering & Query Parameters",
      "item": [
        {
          "name": "Filter Bookings by Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returns array of booking IDs matching filter\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.be.an(\"array\");\r\n});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Generate a standard ISO timestamp (e.g., 2026-10-19T15:55:00.000Z)\r\nconst currentTimestamp = new Date().toISOString();\r\npm.variables.set(\"customTimestamp\", currentTimestamp);\r\n\r\n// 2. Generate a timestamp for 7 days in the future\r\nconst futureDate = new Date();\r\nfutureDate.setDate(futureDate.getDate() + 7);\r\npm.variables.set(\"futureTimestamp\", futureDate.toISOString());\r\n\r\n// 3. Generate a custom random string or ID\r\nconst randomId = \"USER-\" + Math.floor(Math.random() * 10000);\r\npm.variables.set(\"customUserId\", randomId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bookerUrl}}/booking?firstname=Sarah",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "Sarah"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Filter Bookings by Check-in Date",
          "event": [
