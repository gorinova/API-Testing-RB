    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Generate Auth Token (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Auth token is generated and stored in environment\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.have.property(\"token\");\r\n    pm.expect(data.token).to.be.a(\"string\").that.is.not.empty;\r\n    pm.environment.set(\"authToken\", data.token);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bookerUrl}}/auth",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Generate Auth Token (Invalid Credentials - Negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returns Bad credentials message\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.reason).to.equal(\"Bad credentials\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"wrongUser\", \"password\": \"wrongPassword\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bookerUrl}}/auth",
              "host": [
                "{{bookerUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
